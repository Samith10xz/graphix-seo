APP_NAME="Graphix SEO"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://seo.graphixdesign.agency
APP_TIMEZONE=Asia/Colombo

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=graphix_seo
DB_USERNAME=graphix
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

# Python engine (internal docker network)
ENGINE_URL=http://engine:8000
ENGINE_API_KEY=

# AI providers — paste keys on the server only
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_FAST_MODEL=claude-haiku-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Which provider handles each task (claude | gemini)
AI_TASK_ANALYSIS=claude
AI_TASK_WRITING=claude
AI_TASK_BULK=gemini

# Data providers
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
PAGESPEED_API_KEY=
