# Used by docker-compose (MySQL) and the Python engine. Copy to .env on the server.
DB_DATABASE=graphix_seo
DB_USERNAME=graphix
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Shared secret between Laravel and the engine (same value as ENGINE_API_KEY in web/.env)
ENGINE_API_KEY=
CRAWLER_UA=GraphixSEOBot/1.0 (+https://seo.graphixdesign.agency/bot)
CRAWL_CONCURRENCY=8
MAX_PAGES_LIMIT=5000
PAGESPEED_API_KEY=
