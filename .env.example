APP_NAME="Graphix SEO"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://seo.graphixdesign.agency
APP_TIMEZONE=Asia/Colombo

LOG_CHANNEL=stack
LOG_LEVEL=info

# Hostinger: 127.0.0.1 and the database created in hPanel.
# VPS (Docker): docker-compose overrides DB_HOST to "mysql".
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Hostinger defaults (no Redis). Docker overrides these to redis.
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# Crawl engine: php (runs inside Laravel, works on shared/cloud hosting)
#               python (separate engine service, VPS only)
CRAWL_ENGINE=php
CRAWL_CHUNK_SIZE=20
CRAWL_CONCURRENCY=5
CRAWL_MAX_PAGES=1000
CRAWLER_UA="GraphixSEOBot/1.0 (+https://seo.graphixdesign.agency/bot)"

# Python engine (VPS only)
ENGINE_URL=http://engine:8000
ENGINE_API_KEY=

# AI providers — paste keys on the server only
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_FAST_MODEL=claude-haiku-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Which provider handles each task (claude | gemini)
AI_TASK_ANALYSIS=claude
AI_TASK_WRITING=claude
AI_TASK_BULK=gemini

# Data providers
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
PAGESPEED_API_KEY=
